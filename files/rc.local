#!/bin/sh

exec >> /tmp/ansible-rc.local.log 2>&1

source /opt/.lycu1580v2/bin/config.sh

# backup student
BACKUP=/home/backup-student-from-`date +%Y_%m_%d-%H_%M_%S`
mv /home/student/ $BACKUP
chown root:teacher $BACKUP
chmod 0750 $BACKUP

# backup olymp
# BACKUP=/home/backup-olymp-from-`date +%Y_%m_%d-%H_%M_%S`
# mv /home/olymp/ $BACKUP
# chown root:teacher $BACKUP
# chmod 0750 $BACKUP

# create new standart student home
rsync -a --chown=student:student /etc/skel/ /home/student/

# add 1580 files for student
rsync -a --chown=student:student $base_path/files/home_student/ /home/student/

# create new standart olymp home
rsync -a --chown=olymp:olymp /etc/skel/ /home/olymp/

# add 1580 files for olymp
#rsync -a --chown=olymp:olymp $base_path/files/home_olymp/ /home/olymp/

#for olymp
#[ ! -f /home/olymp/Рабочий\ стол/olymp-windows_vm.sh ] && 
#rsync -au --chown=olymp:olymp $base_path/files/home_olymp/ /home/olymp/
#cp $base_path/files/home_olymp/.config/powermanagementprofilesrc /home/olymp/.config/powermanagementprofilesrc
#cp $base_path/files/home_olymp/ /home/olymp/.config/powermanagementprofilesrc
#cp $base_path/files/home_olymp/: /home/olymp/.config/powermanagementprofilesrc
#chown olymp $base_path/local/olymp-windows_vdi/olymp-windows.vdi
#chown olymp $base_path/local/olymp-linux_vdi/olymp-linux.vdi

# remove mos welcome
rm -f /home/student/.config/autostart/mos-welcome-pages.desktop

# remove kompas 21 if not 1580
# [ ! `hostname | grep 1580` ] && 
#rm /home/student/Рабочий\ стол/KOMPAS_3D_21.sh

# remove VistualBox start scripts if no ready
[ ! -f $base_path/local/ege-windows_vdi/ege-windows.vdi ] && rm /home/student/Рабочий\ стол/ege-windows_vm.sh
[ ! -f $base_path/local/olymp-windows_vdi/olymp-windows.vdi ] && rm /home/student/Рабочий\ стол/olymp-windows_vm.sh
[ ! -f $base_path/local/olymp-linux_vdi/olymp-linux.vdi ] && rm /home/student/Рабочий\ стол/olymp-linux_vm.sh
[ ! -f $base_path/local/w10pabc_vdi/ready01.timestamp ] && rm /home/student/Рабочий\ стол/PascalABC_windows_vm.sh
[ ! -f $base_path/local/w10k22_vdi/ready04.timestamp ] && rm /home/student/Рабочий\ стол/KOMPAS_3D_22_windows_vm.sh
[ ! -f $base_path/local/w10tfc17_vdi/ready01.timestamp ] && rm /home/student/Рабочий\ стол/T-FLEX_CAD_17_windows_wm.sh
[ ! -f $base_path/local/w10ev3_vdi/ready01.timestamp ] && rm /home/student/Рабочий\ стол/EV3_windows_wm.sh
[ ! -f $base_path/local/w10vs2022_vdi/ready04.timestamp ] && rm /home/student/Рабочий\ стол/Visual_Studio_2022_windows_vm.sh

[ ! -f $base_path/local/processing_tar/ready01.timestamp ] && rm /home/student/Рабочий\ стол/processing.sh
[ ! -f $base_path/local/idea_ic_tar/ready01.timestamp ] && rm /home/student/Рабочий\ стол/idea.sh

# do not automatically start chromium on pannels
[ `hostname | grep p1580` ] && rm /home/student/.config/autostart/chromium.desktop

# remove pannel power managment settings on pannels
#[ `hostname | grep p1580` ] && rm -f /home/student/.config/powermanagementprofilesrc

# set pannel power managment settings in IT-polygon
[ `hostname | grep p1580` ] && rsync -a --chown=student:student $base_path/files/powermanagementprofilesrc-p1580 /home/student/.config/powermanagementprofilesrc

# update dot wine
# rsync -a --delete --chown=student:student /opt/.lycu1580/files/opt_1580/student_dot_wine-kompas/ 
# rm -rf /home/student_dot_wine-kompas_current/

# remove PascalABC old script if it is absent
#[ ! -f /opt/.lycu1580/local/student_dot_wine_klt_pabc_tbz/ready01.timestamp ] && rm /home/student/Рабочий\ стол/PascalABC_old.sh

# update student_dot_wine_klt_pabc_current
# [ -f /opt/.lycu1580/local/student_dot_wine_klt_pabc_tbz/ready01.timestamp ] && rsync -a --delete --chown=student:student /opt/.lycu1580/local/student_dot_wine_klt_pabc_tbz/student_dot_wine_klt_pabc/ 
# rm -rf /home/student_dot_wine_klt_pabc_current/

# delete old (not today) backups
DATE=`date +%Y_%m_%d`
for FILE in /home/backup-*
do
    [ ! "`echo $FILE | grep $DATE`" ] && rm -rf $FILE
done

# disable virtualbox network brige
rmmod vboxnetflt

# for oge
gpasswd olymp -a examen

# not block inet on pannels
hostname | grep p1580 && exit


#date +"%F%R" | grep 2025-01-2016 && exit

#date +%F |grep 2025-05-17 && hostname | grep 1580-1 && /opt/.lycu1580v2/bin/iptables.sh
#date +%F |grep 2025-05-20 && hostname | grep 1580-2 && /opt/.lycu1580v2/bin/iptables.sh

date +%F |grep 2025-05-31 && hostname | grep 1580-1 && /opt/.lycu1580v2/bin/iptables.sh
