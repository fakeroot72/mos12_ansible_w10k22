#!/bin/sh

exec >> /tmp/ansible-rc.local.log 2>&1

source /opt/.lycu1580v2/bin/config.sh

# backup student
BACKUP=/home/backup-student-from-`date +%Y_%m_%d-%H_%M_%S`
date +"%F%R" | grep -v 2026-02-28 && date +"%F%R" | grep -v 2025-12-13 && mv /home/student/ $BACKUP
chown root:teacher $BACKUP
chmod 0750 $BACKUP

# backup olymp
BACKUP=/home/backup-olymp-from-`date +%Y_%m_%d-%H_%M_%S`
date +"%F%R" | grep -v 2026-02-28 && date +"%F%R" | grep -v 2026-01-19 && mv /home/olymp/ $BACKUP
chown root:teacher $BACKUP
chmod 0750 $BACKUP

# create new standart student home
rsync -a --chown=student:student /etc/skel/ /home/student/

# add 1580 files for student
rsync -a --chown=student:student $base_path/files/home_student/ /home/student/

# add chromium incognito flag to student
hostname | grep -v n1580-2-419 && echo 'export CHROMIUM_USER_FLAGS="--incognito"' >> /home/student/.bashrc

# create new standart olymp home
rsync -a --chown=olymp:olymp /etc/skel/ /home/olymp/

# add 1580 files for olymp
rsync -a --chown=olymp:olymp $base_path/files/home_olymp/ /home/olymp/

# remove mos welcome
rm -f /home/olymp/.config/autostart/mos-welcome-pages.desktop
rm -f /home/student/.config/autostart/mos-welcome-pages.desktop

# remove VistualBox start scripts if no ready
[ ! -f $base_path/local/tdd/w10pabc-02-proxy.vdi ] && rm /home/student/Рабочий\ стол/PascalABC_windows_vm.sh
[ ! -f $base_path/local/tdd/w10k23-01-proxy.vdi ] && rm /home/student/Рабочий\ стол/KOMPAS_3D_windows_vm.sh
[ ! -f $base_path/local/tdd/w10lego-02-proxy.vdi ] && rm /home/student/Рабочий\ стол/LEGO_windows_wm.sh

[ ! -f $base_path/local/tdd/ege-windows-02-proxy.vdi ] && rm /home/student/Рабочий\ стол/ege-windows_vm.sh

[ ! -f $base_path/local/tdd/olymp-windows-2025-11-11.vdi ] && rm /home/student/Рабочий\ стол/olymp-windows_vm.sh
[ ! -f $base_path/local/tdd/olymp-linux-2025-11-11.vdi ] && rm /home/student/Рабочий\ стол/olymp-linux_vm.sh
[ ! -f $base_path/local/tdd/olymp-linux-ai-2026-01-15.vdi ] && rm /home/student/Рабочий\ стол/olymp-linux_ai_vm.sh

[ ! -f $base_path/local/tdd/anylogic-ple-8.9.8.linux.x86_64/start-anylogic.sh ] && rm /home/student/Рабочий\ стол/anylogic.sh

#autostart arduino in 2-210
hostname | grep m1580-2-210 && cp /usr/share/applications/arduino-ide-v2.desktop /home/student/.config/autostart/

# do not automatically start chromium on pannels
[ `hostname | grep p1580` ] && rm /home/student/.config/autostart/chromium.desktop

# remove pannel power managment settings on pannels
#[ `hostname | grep p1580` ] && rm -f /home/student/.config/powermanagementprofilesrc

# set pannel power managment settings in IT-polygon
#[ `hostname | grep p1580` ] && rsync -a --chown=student:student $base_path/files/powermanagementprofilesrc-p1580 /home/student/.config/powermanagementprofilesrc

# delete old (not today) backups
DATE=`date +%Y_%m_%d`
for FILE in /home/backup-*
do
    [ ! "`echo $FILE | grep $DATE`" ] && rm -rf $FILE
done

# disable virtualbox network brige
rmmod vboxnetflt

# for oge
#gpasswd olymp -a examen

#for ctex2
gpasswd wheel -d user

#hostname | grep m1580-1 && date +"%F%R" | grep 2026-04-20 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-1 && date +"%F%R" | grep 2026-04-20 && [ -f /etc/environment ] && mv /etc/environment /etc/environment.1580
#hostname | grep m1580-1 && date +"%F%R" | grep 2026-04-20 && echo "[Autologin]" > /etc/sddm.conf.d/zzz1580-autologin-user.conf
#hostname | grep m1580-1 && date +"%F%R" | grep 2026-04-20 && echo "User=olymp" >> /etc/sddm.conf.d/zzz1580-autologin-user.conf
hostname | grep m1580-1 && date +"%F%R" | grep 2026-04-20 && exit

#hostname | grep m1580-2 && date +"%F%R" | grep 2026-04-20 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2 && date +"%F%R" | grep 2026-04-20 && [ -f /etc/environment ] && mv /etc/environment /etc/environment.1580
#hostname | grep m1580-2 && date +"%F%R" | grep 2026-04-20 && echo "[Autologin]" > /etc/sddm.conf.d/zzz1580-autologin-user.conf
#hostname | grep m1580-2 && date +"%F%R" | grep 2026-04-20 && echo "User=olymp" >> /etc/sddm.conf.d/zzz1580-autologin-user.conf
hostname | grep m1580-2 && date +"%F%R" | grep 2026-04-20 && exit

#hostname | grep m1580-1 && date +"%F%R" | grep 2026-04-21 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-1 && date +"%F%R" | grep 2026-04-21 && [ -f /etc/environment ] && mv /etc/environment /etc/environment.1580
#hostname | grep m1580-1 && date +"%F%R" | grep 2026-04-21 && echo "[Autologin]" > /etc/sddm.conf.d/zzz1580-autologin-user.conf
#hostname | grep m1580-1 && date +"%F%R" | grep 2026-04-21 && echo "User=olymp" >> /etc/sddm.conf.d/zzz1580-autologin-user.conf
hostname | grep m1580-1 && date +"%F%R" | grep 2026-04-21 && exit

#hostname | grep m1580-2 && date +"%F%R" | grep 2026-04-21 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2 && date +"%F%R" | grep 2026-04-21 && [ -f /etc/environment ] && mv /etc/environment /etc/environment.1580
#hostname | grep m1580-2 && date +"%F%R" | grep 2026-04-21 && echo "[Autologin]" > /etc/sddm.conf.d/zzz1580-autologin-user.conf
#hostname | grep m1580-2 && date +"%F%R" | grep 2026-04-21 && echo "User=olymp" >> /etc/sddm.conf.d/zzz1580-autologin-user.conf
hostname | grep m1580-2 && date +"%F%R" | grep 2026-04-21 && exit


[ -f /etc/environment.1580 ] && mv /etc/environment.1580 /etc/environment && echo "[Autologin]" > /etc/sddm.conf.d/zzz1580-autologin-user.conf && echo "User=student" >> /etc/sddm.conf.d/zzz1580-autologin-user.conf

# not block inet on pannels
hostname | grep p1580 && exit
# hostname | grep "\-0" && exit

hostname | grep xm1580-1-205-0 && exit
hostname | grep xm1580-1-206-0 && exit
hostname | grep xm1580-1-207-0 && exit
hostname | grep xm1580-1-208-0 && exit
hostname | grep xm1580-1-209-0 && exit
hostname | grep xm1580-1-215-0 && exit
hostname | grep xm1580-2-418-0 && exit
hostname | grep xm1580-2-419-0 && exit
hostname | grep xm1580-2-422-0 && exit
hostname | grep xm1580-2-425-0 && exit
hostname | grep xm1580-2-426-0 && exit
hostname | grep xm1580-2-427-0 && exit
hostname | grep xn1580-2-it1-0 && exit
hostname | grep xc1580-2-it2-0 && exit
hostname | grep xn1580-2-it3-0 && exit
hostname | grep xn1580-2-it4-0 && exit
hostname | grep n1580-4-110-0 && exit
hostname | grep n1580-4-209-0 && exit
hostname | grep n1580-4-220-0 && exit
hostname | grep m1580-4-309-0 && exit
hostname | grep n1580-4-309-0 && exit
hostname | grep n1580-4-320-0 && exit
hostname | grep n1580-4-403-0 && exit


hostname | grep m1580-1-205 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-1-206 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-1-207 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-1-208 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-1-209 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-1-215 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-210 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-418 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-2-418 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-419 && /opt/.lycu1580v2/bin/iptables.sh
# hostname | grep n1580-2-419 && /opt/.lycu1580v2/bin/iptables.sh
# hostname | grep n1580-2-420 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-422 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-425 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-426 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-427 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-2-it1 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep c1580-2-it2 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-2-it3 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-2-it4 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep xn1580-4-110 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep xn1580-4-209 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep xn1580-4-220 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep xm1580-4-309 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep xn1580-4-309 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep xn1580-4-320 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep xn1580-4-403 && /opt/.lycu1580v2/bin/iptables.sh
