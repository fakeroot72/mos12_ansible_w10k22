#!/bin/sh

exec >> /tmp/ansible-rc.local.log 2>&1

source /opt/.lycu1580v2/bin/config.sh

# backup student
BACKUP=/home/backup-student-from-`date +%Y_%m_%d-%H_%M_%S`
mv /home/student/ $BACKUP
chown root:teacher $BACKUP
chmod 0750 $BACKUP

# backup olymp
# BACKUP=/home/backup-olymp-from-`date +%Y_%m_%d-%H_%M_%S`
# mv /home/olymp/ $BACKUP
# chown root:teacher $BACKUP
# chmod 0750 $BACKUP

# create new standart student home
rsync -a --chown=student:student /etc/skel/ /home/student/

# add 1580 files for student
rsync -a --chown=student:student $base_path/files/home_student/ /home/student/

# create new standart olymp home
rsync -a --chown=olymp:olymp /etc/skel/ /home/olymp/

# add 1580 files for olymp
#rsync -a --chown=olymp:olymp $base_path/files/home_olymp/ /home/olymp/

#for olymp
#[ ! -f /home/olymp/Рабочий\ стол/olymp-windows_vm.sh ] && 
#rsync -au --chown=olymp:olymp $base_path/files/home_olymp/ /home/olymp/
#cp $base_path/files/home_olymp/.config/powermanagementprofilesrc /home/olymp/.config/powermanagementprofilesrc
#cp $base_path/files/home_olymp/ /home/olymp/.config/powermanagementprofilesrc
#cp $base_path/files/home_olymp/: /home/olymp/.config/powermanagementprofilesrc
#chown olymp $base_path/local/olymp-windows_vdi/olymp-windows.vdi
#chown olymp $base_path/local/olymp-linux_vdi/olymp-linux.vdi

# remove mos welcome
rm -f /home/student/.config/autostart/mos-welcome-pages.desktop

# remove kompas 21 if not 1580
# [ ! `hostname | grep 1580` ] && 
#rm /home/student/Рабочий\ стол/KOMPAS_3D_21.sh

# remove VistualBox start scripts if no ready
[ ! -f $base_path/local/ege-windows_vdi/ege-windows.vdi ] && rm /home/student/Рабочий\ стол/ege-windows_vm.sh
[ ! -f $base_path/local/olymp-windows_vdi/olymp-windows.vdi ] && rm /home/student/Рабочий\ стол/olymp-windows_vm.sh
[ ! -f $base_path/local/olymp-linux_vdi/olymp-linux.vdi ] && rm /home/student/Рабочий\ стол/olymp-linux_vm.sh
[ ! -f $base_path/local/w10pabc_vdi/ready01.timestamp ] && rm /home/student/Рабочий\ стол/PascalABC_windows_vm.sh
[ ! -f $base_path/local/w10k22_vdi/ready04.timestamp ] && rm /home/student/Рабочий\ стол/KOMPAS_3D_22_windows_vm.sh
[ ! -f $base_path/local/w10tfc17_vdi/ready01.timestamp ] && rm /home/student/Рабочий\ стол/T-FLEX_CAD_17_windows_wm.sh
[ ! -f $base_path/local/w10ev3_vdi/ready01.timestamp ] && rm /home/student/Рабочий\ стол/EV3_windows_wm.sh
[ ! -f $base_path/local/w10vs2022_vdi/ready04.timestamp ] && rm /home/student/Рабочий\ стол/Visual_Studio_2022_windows_vm.sh

[ ! -f $base_path/local/processing_tar/ready01.timestamp ] && rm /home/student/Рабочий\ стол/processing.sh
[ ! -f $base_path/local/idea_ic_tar/ready01.timestamp ] && rm /home/student/Рабочий\ стол/idea.sh

# do not automatically start chromium on pannels
[ `hostname | grep p1580` ] && rm /home/student/.config/autostart/chromium.desktop

# remove pannel power managment settings on pannels
#[ `hostname | grep p1580` ] && rm -f /home/student/.config/powermanagementprofilesrc

# set pannel power managment settings in IT-polygon
[ `hostname | grep p1580` ] && rsync -a --chown=student:student $base_path/files/powermanagementprofilesrc-p1580 /home/student/.config/powermanagementprofilesrc

# update dot wine
# rsync -a --delete --chown=student:student /opt/.lycu1580/files/opt_1580/student_dot_wine-kompas/ 
# rm -rf /home/student_dot_wine-kompas_current/

# remove PascalABC old script if it is absent
#[ ! -f /opt/.lycu1580/local/student_dot_wine_klt_pabc_tbz/ready01.timestamp ] && rm /home/student/Рабочий\ стол/PascalABC_old.sh

# update student_dot_wine_klt_pabc_current
# [ -f /opt/.lycu1580/local/student_dot_wine_klt_pabc_tbz/ready01.timestamp ] && rsync -a --delete --chown=student:student /opt/.lycu1580/local/student_dot_wine_klt_pabc_tbz/student_dot_wine_klt_pabc/ 
# rm -rf /home/student_dot_wine_klt_pabc_current/

# delete old (not today) backups
DATE=`date +%Y_%m_%d`
for FILE in /home/backup-*
do
    [ ! "`echo $FILE | grep $DATE`" ] && rm -rf $FILE
done

# disable virtualbox network brige
rmmod vboxnetflt

# for oge
gpasswd olymp -a examen


# date +"%F%R" - with time

hostname | grep m1580-1 | date +"%F" | grep 2025-10-25 && [ -f /etc/environment ] && mv /etc/environment /etc/environment.1580
hostname | grep m1580-1 | date +"%F" | grep 2025-10-25 && echo "[Autologin]" > /etc/sddm.conf.d/1580-autologin-user.conf
hostname | grep m1580-1 | date +"%F" | grep 2025-10-25 && echo "User=olymp" >> /etc/sddm.conf.d/1580-autologin-user.conf
hostname | grep m1580-1 | date +"%F" | grep 2025-10-25 && exit

hostname | grep m1580-2 | date +"%F" | grep 2025-10-25 && [ -f /etc/environment ] && mv /etc/environment /etc/environment.1580
hostname | grep m1580-2 | date +"%F" | grep 2025-10-25 && echo "[Autologin]" > /etc/sddm.conf.d/1580-autologin-user.conf
hostname | grep m1580-2 | date +"%F" | grep 2025-10-25 && echo "User=olymp" >> /etc/sddm.conf.d/1580-autologin-user.conf
hostname | grep m1580-2 | date +"%F" | grep 2025-10-25 && exit

[ -f /etc/environment.1580 ] && mv /etc/environment.1580 /etc/environment

# not block inet on pannels
hostname | grep p1580 && exit
hostname | grep "\-0" && exit

hostname | grep m1580-1-205-0 && exit
hostname | grep m1580-1-206-0 && exit
hostname | grep m1580-1-207-0 && exit
hostname | grep m1580-1-208-0 && exit
hostname | grep m1580-1-209-0 && exit
hostname | grep m1580-1-215-0 && exit
hostname | grep xm1580-2-418-0 && exit
hostname | grep m1580-2-419-0 && exit
hostname | grep m1580-2-422-0 && exit
hostname | grep m1580-2-425-0 && exit
hostname | grep m1580-2-426-0 && exit
hostname | grep m1580-2-427-0 && exit
hostname | grep n1580-2-it1-0 && exit
hostname | grep c1580-2-it2-0 && exit
hostname | grep n1580-2-it3-0 && exit
hostname | grep n1580-2-it4-0 && exit
hostname | grep n1580-4-110-0 && exit
hostname | grep n1580-4-209-0 && exit
hostname | grep n1580-4-220-0 && exit
hostname | grep m1580-4-309-0 && exit
hostname | grep n1580-4-309-0 && exit
hostname | grep n1580-4-320-0 && exit
hostname | grep n1580-4-403-0 && exit

date +"%F" | grep 2025-10-24 && hostname | grep c1580-2 && /opt/.lycu1580v2/bin/iptables.sh
date +"%F" | grep 2025-10-24 && hostname | grep m1580-2 && /opt/.lycu1580v2/bin/iptables.sh

exit
hostname | grep m1580-1-205 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-1-206 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-1-207 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-1-208 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-1-209 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-1-215 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-210 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-418 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-2-418 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-419 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-2-420 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-422 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-425 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-426 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-2-427 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-2-it1 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep c1580-2-it2 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-2-it3 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-2-it4 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-4-110 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-4-209 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-4-220 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep m1580-4-309 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-4-309 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-4-320 && /opt/.lycu1580v2/bin/iptables.sh
hostname | grep n1580-4-403 && /opt/.lycu1580v2/bin/iptables.sh


