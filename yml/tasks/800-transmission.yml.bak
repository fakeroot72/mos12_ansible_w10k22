    state: restarted

- name: anylogic remove
  ansible.builtin.file:
    dest: local/tdd/anylogic-ple-8.9.8.linux.x86_64
    state: absent
  vars:
    anylogic_exclude_r:
      - nowhwre
  loop:
    - xm1580-1
  loop_control:
