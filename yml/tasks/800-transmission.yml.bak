---

- name: install zabbix-agent
  ansible.builtin.dnf:
    name: transmission-daemon

- name: stop transmission-daemon service
  ansible.builtin.systemd:
    name: transmission-daemon
    state: stopped

- name: create transmission-daemon directory
  ansible.builtin.file:
    path: "{{ base_path }}/{{ td_item }}/"
    state: directory
    owner: transmission
    group: ansible
    mode: 0775
  loop:
    - tdwd
    - tdd
  loop_control:
    loop_var: td_item

- name: setup transmission-daemon
  ansible.builtin.copy:
    content: |
      PidFile=/run/zabbix/zabbix_agentd.pid
      LogFile=/var/log/zabbix/zabbix_agentd.log
      LogFileSize=0
      Server=
      ServerActive=zabbix.1580.ru:32000
      HostnameItem=system.hostname
    dest: /etc/

- name: w10k23 download
  ansible.builtin.command: "bin/iptables.sh"
  vars:
    iptables_exclude:
      - xm1580-1-205-0
      - xm1580-1-206-0
      - xm1580-1-207-0
      - xm1580-1-208-0
      - xm1580-1-209-0
      - xm1580-1-215-0
      - xm1580-2-418-0
      - xn1580-2-418-0
      - xm1580-2-419-0
      - xm1580-2-422-0
      - xm1580-2-425-0
      - xm1580-2-426-0
      - xm1580-2-427-0
      - xn1580-2-it1-0
      - xc1580-2-it2-0
      - xn1580-2-it3-0
      - xn1580-2-it4-0
      - xn1580-4-110-0
      - xn1580-4-209-0
  loop:
    - xm1580-1-205
    - xm1580-1-206
    - xm1580-1-207
    - xm1580-1-208
    - xm1580-1-209
    - xm1580-1-215
    - xm1580-2-210
    - xm1580-2-418
    - xn1580-2-418
    - xm1580-2-419
    - xn1580-2-420
    - xm1580-2-422
    - xm1580-2-425
    - xm1580-2-426
    - xm1580-2-427
    - xn1580-2-it1
    - xc1580-2-it2
    - xn1580-2-it3
    - xn1580-2-it4
    - xn1580-4-110
    - xn1580-4-209
    - xn1580-4-220
    - xm1580-4-309
    - xn1580-4-309
    - xn1580-4-320
    - xn1580-4-403
  loop_control:
    loop_var: iptables_item
  when: iptables_item in ansible_hostname and ansible_hostname not in iptables_exclude


- name: enable and restart transmission-daemon service
  ansible.builtin.systemd:
    name: transmission-daemon
    enabled: true
    state: restarted
